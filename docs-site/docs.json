{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Continua",
  "description": "Self-hosted observability for AI agent runs: capture traces, spans, sessions, and events, then investigate them in the debugger. Continua's durable workflow engine is available as a preview.",
  "colors": {
    "primary": "#7864a7",
    "light": "#b5a2d8",
    "dark": "#7864a7"
  },
  "background": {
    "color": {
      "light": "#fafaf8",
      "dark": "#202124"
    }
  },
  "fonts": {
    "family": "Manrope",
    "weight": 500,
    "heading": {
      "family": "Manrope",
      "weight": 700
    }
  },
  "favicon": {
    "light": "/brand/continua-mark-light.svg",
    "dark": "/brand/continua-mark-dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/brand/continua-wordmark-light.svg",
    "dark": "/brand/continua-wordmark-dark.svg",
    "href": "https://www.continua.in"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
